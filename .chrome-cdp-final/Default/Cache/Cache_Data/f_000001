<!doctype html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>合成缺陷图像标注与复核</title>
    <link rel="icon" href="data:,">
    <style>
        :root {
            --bg: #f3f6f8;
            --surface: #ffffff;
            --text: #15232d;
            --muted: #667782;
            --border: #dce4e8;
            --accent: #207f78;
            --accent-strong: #175f5a;
            --blue: #2b6cb0;
            --warning: #d68a1f;
            --danger: #c94d47;
            --shadow: 0 1px 2px rgba(23, 43, 54, 0.06);
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            min-width: 320px;
            background: var(--bg);
            color: var(--text);
            font-family: "Segoe UI", "Microsoft YaHei", Arial, sans-serif;
            font-size: 14px;
        }

        button,
        input,
        select {
            font: inherit;
        }

        .page {
            width: min(1480px, 100%);
            margin: 0 auto;
            padding: 28px;
        }

        .page-header {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 18px;
        }

        .page-title {
            margin: 0;
            font-size: 28px;
            line-height: 1.2;
            letter-spacing: 0;
        }

        .page-caption {
            margin: 7px 0 0;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.5;
        }

        .nav-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
            padding: 0 16px;
            border-radius: 6px;
            background: var(--text);
            color: #ffffff;
            font-weight: 600;
            text-decoration: none;
            white-space: nowrap;
        }

        .load-status {
            min-height: 20px;
            margin-bottom: 12px;
            color: var(--muted);
        }

        .load-status[data-state="error"] {
            color: var(--danger);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .stat {
            min-height: 90px;
            padding: 16px 18px;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--surface);
            box-shadow: var(--shadow);
        }

        .stat-label {
            margin: 0 0 10px;
            color: var(--muted);
            font-size: 13px;
            font-weight: 600;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 700;
            line-height: 1;
        }

        .workspace {
            display: grid;
            grid-template-columns: 260px minmax(360px, 1fr) 340px;
            gap: 16px;
            align-items: start;
        }

        .panel {
            min-width: 0;
            border: 1px solid var(--border);
            border-radius: 8px;
            background: var(--surface);
            box-shadow: var(--shadow);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            min-height: 54px;
            padding: 14px 16px;
            border-bottom: 1px solid var(--border);
        }

        .panel-title {
            margin: 0;
            font-size: 16px;
            line-height: 1.3;
        }

        .panel-meta {
            color: var(--muted);
            font-size: 12px;
            white-space: nowrap;
        }

        .image-list {
            max-height: 690px;
            padding: 8px;
            overflow-y: auto;
        }

        .image-button {
            display: grid;
            grid-template-columns: 54px minmax(0, 1fr) auto;
            gap: 10px;
            align-items: center;
            width: 100%;
            min-height: 66px;
            padding: 8px;
            border: 1px solid transparent;
            border-radius: 6px;
            background: transparent;
            color: var(--text);
            text-align: left;
            cursor: pointer;
        }

        .image-button:hover {
            background: #f5f8f9;
        }

        .image-button[aria-current="true"] {
            border-color: rgba(32, 127, 120, 0.4);
            background: rgba(32, 127, 120, 0.08);
        }

        .image-thumb {
            width: 54px;
            height: 42px;
            border: 1px solid var(--border);
            border-radius: 4px;
            background: #e7edf1;
            object-fit: cover;
        }

        .image-name {
            min-width: 0;
            overflow: hidden;
            font-weight: 600;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .image-subtitle {
            margin-top: 4px;
            color: var(--muted);
            font-size: 12px;
        }

        .status-pill {
            padding: 4px 7px;
            border-radius: 999px;
            background: #edf1f3;
            color: #526571;
            font-size: 11px;
            font-weight: 600;
            white-space: nowrap;
        }

        .status-pill[data-status="已标注"] {
            background: #e3f2ef;
            color: var(--accent-strong);
        }

        .status-pill[data-status="已复核"] {
            background: #e7eef7;
            color: var(--blue);
        }

        .preview-body {
            padding: 16px;
        }

        .preview-frame {
            position: relative;
            display: grid;
            min-height: 360px;
            place-items: center;
            overflow: hidden;
            border: 1px solid var(--border);
            border-radius: 6px;
            background:
                linear-gradient(45deg, #edf1f3 25%, transparent 25%),
                linear-gradient(-45deg, #edf1f3 25%, transparent 25%),
                linear-gradient(45deg, transparent 75%, #edf1f3 75%),
                linear-gradient(-45deg, transparent 75%, #edf1f3 75%);
            background-position: 0 0, 0 8px, 8px -8px, -8px 0;
            background-size: 16px 16px;
        }

        .preview-image {
            display: block;
            max-width: 100%;
            max-height: 560px;
        }

        .box-layer {
            position: absolute;
            pointer-events: none;
        }

        .annotation-box {
            position: absolute;
            border: 2px solid var(--accent);
            background: rgba(32, 127, 120, 0.08);
        }

        .annotation-box[data-code="D02"] {
            border-color: var(--warning);
            background: rgba(214, 138, 31, 0.08);
        }

        .annotation-box[data-code="D03"] {
            border-color: var(--blue);
            background: rgba(43, 108, 176, 0.08);
        }

        .annotation-box[data-code="D04"] {
            border-color: var(--danger);
            background: rgba(201, 77, 71, 0.08);
        }

        .annotation-label {
            position: absolute;
            left: -2px;
            bottom: 100%;
            max-width: 160px;
            padding: 2px 5px;
            overflow: hidden;
            background: currentColor;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .preview-empty {
            color: var(--muted);
        }

        .editor-body {
            padding: 16px;
        }

        .field-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .field {
            min-width: 0;
        }

        .field--wide {
            grid-column: span 2;
        }

        .field-label {
            display: block;
            margin-bottom: 6px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
        }

        .field-input {
            width: 100%;
            min-height: 38px;
            padding: 8px 10px;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: #ffffff;
            color: var(--text);
        }

        .field-input:focus {
            border-color: var(--accent);
            outline: 3px solid rgba(32, 127, 120, 0.16);
        }

        .field-input:disabled {
            background: #f1f4f5;
            color: var(--muted);
        }

        .button-row {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 14px;
        }

        .button {
            min-height: 38px;
            padding: 0 13px;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: #ffffff;
            color: var(--text);
            font-weight: 600;
            cursor: pointer;
        }

        .button:hover:not(:disabled) {
            border-color: #b9c7ce;
            background: #f8fafb;
        }

        .button--primary {
            border-color: var(--accent);
            background: var(--accent);
            color: #ffffff;
        }

        .button--primary:hover:not(:disabled) {
            border-color: var(--accent-strong);
            background: var(--accent-strong);
        }

        .button--danger {
            color: var(--danger);
        }

        .button:disabled {
            cursor: not-allowed;
            opacity: 0.5;
        }

        .annotation-list {
            display: grid;
            gap: 8px;
            margin-top: 16px;
        }

        .annotation-item {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 8px;
            align-items: center;
            padding: 9px 10px;
            border: 1px solid var(--border);
            border-radius: 6px;
            background: #f8fafb;
        }

        .annotation-name {
            min-width: 0;
            overflow: hidden;
            font-weight: 600;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .annotation-coordinates {
            margin-top: 3px;
            color: var(--muted);
            font-size: 12px;
        }

        .remove-button {
            min-height: 30px;
            padding: 0 9px;
            border: 1px solid #efd2d0;
            border-radius: 5px;
            background: #fff7f6;
            color: var(--danger);
            font-weight: 600;
            cursor: pointer;
        }

        .remove-button:disabled {
            cursor: not-allowed;
            opacity: 0.45;
        }

        .empty-state {
            padding: 24px 12px;
            color: var(--muted);
            text-align: center;
        }

        @media (max-width: 1120px) {
            .stats-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .workspace {
                grid-template-columns: 230px minmax(0, 1fr);
            }

            .editor-panel {
                grid-column: span 2;
            }
        }

        @media (max-width: 760px) {
            .page {
                padding: 18px;
            }

            .page-header {
                align-items: stretch;
                flex-direction: column;
            }

            .page-title {
                font-size: 24px;
            }

            .nav-link {
                width: 100%;
            }

            .workspace {
                grid-template-columns: 1fr;
            }

            .editor-panel {
                grid-column: auto;
            }

            .image-list {
                max-height: 310px;
            }

            .preview-frame {
                min-height: 260px;
            }
        }

        @media (max-width: 480px) {
            .page {
                padding: 14px;
            }

            .stats-grid {
                grid-template-columns: 1fr 1fr;
            }

            .stat {
                padding: 14px;
            }

            .stat-value {
                font-size: 24px;
            }
        }
    </style>
</head>
<body>
    <main class="page">
        <header class="page-header">
            <div>
                <h1 class="page-title">合成缺陷图像标注与复核</h1>
                <p class="page-caption">数据为程序合成，非真实工业图像</p>
            </div>
            <a class="nav-link" href="/dashboard">返回质量看板</a>
        </header>

        <div id="load-status" class="load-status" role="status">正在加载合成数据...</div>

        <section class="stats-grid" aria-label="标注进度">
            <article class="stat">
                <p class="stat-label">图片总数</p>
                <strong id="stat-total" class="stat-value">--</strong>
            </article>
            <article class="stat">
                <p class="stat-label">未标注</p>
                <strong id="stat-unlabeled" class="stat-value">--</strong>
            </article>
            <article class="stat">
                <p class="stat-label">已标注</p>
                <strong id="stat-labeled" class="stat-value">--</strong>
            </article>
            <article class="stat">
                <p class="stat-label">已复核</p>
                <strong id="stat-reviewed" class="stat-value">--</strong>
            </article>
        </section>

        <section class="workspace">
            <aside class="panel">
                <header class="panel-header">
                    <h2 class="panel-title">图片</h2>
                    <span id="image-count" class="panel-meta">0 张</span>
                </header>
                <div id="image-list" class="image-list"></div>
            </aside>

            <section class="panel">
                <header class="panel-header">
                    <h2 id="preview-title" class="panel-title">图片预览</h2>
                    <span id="preview-status" class="panel-meta">未选择</span>
                </header>
                <div class="preview-body">
                    <div id="preview-frame" class="preview-frame">
                        <span class="preview-empty">请选择合成图片</span>
                    </div>
                </div>
            </section>

            <aside class="panel editor-panel">
                <header class="panel-header">
                    <h2 class="panel-title">标注编辑</h2>
                    <span id="annotation-count" class="panel-meta">0 个框</span>
                </header>
                <div class="editor-body">
                    <div class="field-grid">
                        <label class="field field--wide">
                            <span class="field-label">缺陷类别</span>
                            <select id="defect-type" class="field-input" disabled></select>
                        </label>
                        <label class="field field--wide">
                            <span class="field-label">标注人</span>
                            <input id="labeled-by" class="field-input" value="标注员" disabled>
                        </label>
                        <label class="field">
                            <span class="field-label">x</span>
                            <input id="box-x" class="field-input" type="number" min="0" value="20" disabled>
                        </label>
                        <label class="field">
                            <span class="field-label">y</span>
                            <input id="box-y" class="field-input" type="number" min="0" value="20" disabled>
                        </label>
                        <label class="field">
                            <span class="field-label">w</span>
                            <input id="box-w" class="field-input" type="number" min="1" value="40" disabled>
                        </label>
                        <label class="field">
                            <span class="field-label">h</span>
                            <input id="box-h" class="field-input" type="number" min="1" value="20" disabled>
                        </label>
                    </div>

                    <div class="button-row">
                        <button id="add-box" class="button" type="button" disabled>添加标注框</button>
                        <button id="save-annotations" class="button button--primary" type="button" disabled>保存标注</button>
                    </div>

                    <div id="annotation-list" class="annotation-list"></div>

                    <div class="field-grid" style="margin-top: 18px;">
                        <label class="field field--wide">
                            <span class="field-label">复核人</span>
                            <input id="reviewed-by" class="field-input" value="复核员" disabled>
                        </label>
                    </div>
                    <div class="button-row">
                        <button id="review-annotations" class="button button--primary" type="button" disabled>标记已复核</button>
                    </div>
                </div>
            </aside>
        </section>
    </main>

    <script>
        const state = {
            images: [],
            defectTypes: [],
            selectedId: null,
            draftAnnotations: []
        };

        const statusElement = document.getElementById("load-status");
        const imageListElement = document.getElementById("image-list");
        const previewFrame = document.getElementById("preview-frame");
        const previewTitle = document.getElementById("preview-title");
        const previewStatus = document.getElementById("preview-status");
        const defectTypeSelect = document.getElementById("defect-type");
        const labeledByInput = document.getElementById("labeled-by");
        const reviewedByInput = document.getElementById("reviewed-by");
        const coordinateInputs = {
            x: document.getElementById("box-x"),
            y: document.getElementById("box-y"),
            w: document.getElementById("box-w"),
            h: document.getElementById("box-h")
        };

        function setStatus(message, stateName) {
            statusElement.textContent = message;
            statusElement.dataset.state = stateName || "";
            statusElement.hidden = !message;
        }

        function selectedImage() {
            return state.images.find((image) => image.id === state.selectedId) || null;
        }

        function setEditorEnabled(enabled) {
            defectTypeSelect.disabled = !enabled;
            labeledByInput.disabled = !enabled;
            Object.values(coordinateInputs).forEach((input) => {
                input.disabled = !enabled;
            });
            document.getElementById("add-box").disabled = !enabled;
            document.getElementById("save-annotations").disabled = !enabled;
        }

        function renderStats(stats) {
            document.getElementById("stat-total").textContent = stats.total;
            document.getElementById("stat-unlabeled").textContent = stats.unlabeled;
            document.getElementById("stat-labeled").textContent = stats.labeled;
            document.getElementById("stat-reviewed").textContent = stats.reviewed;
        }

        function renderDefectTypes() {
            defectTypeSelect.replaceChildren();
            state.defectTypes.forEach((defectType) => {
                const option = document.createElement("option");
                option.value = String(defectType.id);
                option.textContent = `${defectType.code} ${defectType.name}`;
                defectTypeSelect.append(option);
            });
        }

        function renderImageList() {
            imageListElement.replaceChildren();
            document.getElementById("image-count").textContent =
                `${state.images.length} 张`;

            if (!state.images.length) {
                const empty = document.createElement("div");
                empty.className = "empty-state";
                empty.textContent = "暂无合成图片";
                imageListElement.append(empty);
                return;
            }

            state.images.forEach((image) => {
                const button = document.createElement("button");
                button.type = "button";
                button.className = "image-button";
                button.setAttribute(
                    "aria-current",
                    image.id === state.selectedId ? "true" : "false"
                );

                const thumbnail = document.createElement("img");
                thumbnail.className = "image-thumb";
                thumbnail.src = image.image_url;
                thumbnail.alt = "";

                const text = document.createElement("span");
                const name = document.createElement("span");
                name.className = "image-name";
                name.textContent = image.file_name;
                const subtitle = document.createElement("span");
                subtitle.className = "image-subtitle";
                subtitle.textContent =
                    `${image.annotations.length} 个标注框`;
                text.append(name, subtitle);

                const status = document.createElement("span");
                status.className = "status-pill";
                status.dataset.status = image.label_status;
                status.textContent = image.label_status;

                button.append(thumbnail, text, status);
                button.addEventListener("click", () => selectImage(image.id));
                imageListElement.append(button);
            });
        }

        function renderPreview(image) {
            previewFrame.replaceChildren();
            previewTitle.textContent = image.file_name;
            previewStatus.textContent = image.label_status;

            const imageElement = document.createElement("img");
            imageElement.className = "preview-image";
            imageElement.src = image.image_url;
            imageElement.alt = "合成缺陷图像预览";

            const layer = document.createElement("div");
            layer.className = "box-layer";
            imageElement.addEventListener("load", () => {
                layer.style.left = `${imageElement.offsetLeft}px`;
                layer.style.top = `${imageElement.offsetTop}px`;
                layer.style.width = `${imageElement.clientWidth}px`;
                layer.style.height = `${imageElement.clientHeight}px`;
                renderBoxes(layer, image);
            });
            renderBoxes(layer, image);

            previewFrame.append(imageElement, layer);
        }

        function renderBoxes(layer, image) {
            layer.replaceChildren();
            state.draftAnnotations.forEach((annotation) => {
                const box = document.createElement("div");
                box.className = "annotation-box";
                box.dataset.code = annotation.defect_type_code;
                box.style.left = `${annotation.x / image.width * 100}%`;
                box.style.top = `${annotation.y / image.height * 100}%`;
                box.style.width = `${annotation.w / image.width * 100}%`;
                box.style.height = `${annotation.h / image.height * 100}%`;

                const label = document.createElement("span");
                label.className = "annotation-label";
                label.textContent = annotation.defect_type_code;
                box.append(label);
                layer.append(box);
            });
        }

        function renderAnnotationList(image) {
            const list = document.getElementById("annotation-list");
            list.replaceChildren();
            document.getElementById("annotation-count").textContent =
                `${state.draftAnnotations.length} 个框`;

            if (!state.draftAnnotations.length) {
                const empty = document.createElement("div");
                empty.className = "empty-state";
                empty.textContent = image ? "当前没有标注框" : "请选择图片";
                list.append(empty);
                return;
            }

            state.draftAnnotations.forEach((annotation, index) => {
                const item = document.createElement("div");
                item.className = "annotation-item";

                const text = document.createElement("div");
                const name = document.createElement("div");
                name.className = "annotation-name";
                name.textContent =
                    `${annotation.defect_type_code} ${annotation.defect_type_name}`;
                const coordinates = document.createElement("div");
                coordinates.className = "annotation-coordinates";
                coordinates.textContent =
                    `x=${annotation.x}, y=${annotation.y}, w=${annotation.w}, h=${annotation.h}`;
                text.append(name, coordinates);

                const remove = document.createElement("button");
                remove.type = "button";
                remove.className = "remove-button";
                remove.textContent = "移除";
                remove.disabled = image.label_status === "已复核";
                remove.addEventListener("click", () => {
                    state.draftAnnotations.splice(index, 1);
                    renderAnnotationList(image);
                    renderPreview(image);
                });

                item.append(text, remove);
                list.append(item);
            });
        }

        function selectImage(imageId) {
            const image = state.images.find((item) => item.id === imageId);
            if (!image) {
                return;
            }

            state.selectedId = image.id;
            state.draftAnnotations = image.annotations.map((annotation) => ({
                defect_type_id: annotation.defect_type_id,
                defect_type_code: annotation.defect_type_code,
                defect_type_name: annotation.defect_type_name,
                x: annotation.x,
                y: annotation.y,
                w: annotation.w,
                h: annotation.h
            }));

            renderImageList();
            renderPreview(image);
            renderAnnotationList(image);

            const isReviewed = image.label_status === "已复核";
            const canLabel = !isReviewed;
            setEditorEnabled(canLabel);
            reviewedByInput.disabled = isReviewed ||
                image.label_status !== "已标注";
            document.getElementById("review-annotations").disabled = isReviewed ||
                image.label_status !== "已标注";
            if (image.labeled_by) {
                labeledByInput.value = image.labeled_by;
            }
            if (image.reviewed_by) {
                reviewedByInput.value = image.reviewed_by;
            }
        }

        function addDraftAnnotation() {
            const image = selectedImage();
            if (!image) {
                return;
            }

            const defectType = state.defectTypes.find(
                (item) => String(item.id) === defectTypeSelect.value
            );
            const annotation = {
                defect_type_id: Number(defectTypeSelect.value),
                defect_type_code: defectType.code,
                defect_type_name: defectType.name,
                x: Number(coordinateInputs.x.value),
                y: Number(coordinateInputs.y.value),
                w: Number(coordinateInputs.w.value),
                h: Number(coordinateInputs.h.value)
            };

            const values = [
                annotation.x,
                annotation.y,
                annotation.w,
                annotation.h
            ];
            if (values.some((value) => !Number.isInteger(value))) {
                setStatus("坐标必须为整数", "error");
                return;
            }
            if (
                annotation.x < 0 ||
                annotation.y < 0 ||
                annotation.w <= 0 ||
                annotation.h <= 0
            ) {
                setStatus("坐标范围不合法", "error");
                return;
            }
            if (
                annotation.x + annotation.w > image.width ||
                annotation.y + annotation.h > image.height
            ) {
                setStatus("标注框不能超出图片范围", "error");
                return;
            }

            state.draftAnnotations.push(annotation);
            renderAnnotationList(image);
            renderPreview(image);
            setStatus("", "");
        }

        async function saveAnnotations() {
            const image = selectedImage();
            if (!image) {
                return;
            }

            const response = await fetch(
                `/api/annotation/image/${image.id}`,
                {
                    method: "POST",
                    headers: {"Content-Type": "application/json"},
                    body: JSON.stringify({
                        labeled_by: labeledByInput.value.trim(),
                        annotations: state.draftAnnotations.map((annotation) => ({
                            defect_type_id: annotation.defect_type_id,
                            x: annotation.x,
                            y: annotation.y,
                            w: annotation.w,
                            h: annotation.h
                        }))
                    })
                }
            );
            const payload = await response.json();
            if (!response.ok) {
                throw new Error(payload.error || "保存失败");
            }
            await refreshData(payload.id);
            setStatus("标注已保存", "");
        }

        async function reviewAnnotations() {
            const image = selectedImage();
            if (!image) {
                return;
            }

            const response = await fetch(
                `/api/annotation/image/${image.id}/review`,
                {
                    method: "POST",
                    headers: {"Content-Type": "application/json"},
                    body: JSON.stringify({
                        reviewed_by: reviewedByInput.value.trim()
                    })
                }
            );
            const payload = await response.json();
            if (!response.ok) {
                throw new Error(payload.error || "复核失败");
            }
            await refreshData(payload.id);
            setStatus("标注已复核", "");
        }

        async function refreshData(preferredImageId) {
            const [imagesResponse, statsResponse] = await Promise.all([
                fetch("/api/annotation/images"),
                fetch("/api/annotation/stats")
            ]);
            if (!imagesResponse.ok || !statsResponse.ok) {
                throw new Error("标注数据加载失败");
            }
            const imagePayload = await imagesResponse.json();
            const stats = await statsResponse.json();
            state.images = imagePayload.images;
            renderStats(stats);
            renderImageList();

            const targetId = preferredImageId || state.selectedId ||
                (state.images[0] && state.images[0].id);
            if (targetId) {
                selectImage(targetId);
            } else {
                state.selectedId = null;
                state.draftAnnotations = [];
                renderAnnotationList(null);
                previewFrame.replaceChildren();
            }
        }

        async function initialize() {
            try {
                const defectTypeResponse = await fetch(
                    "/api/annotation/defect-types"
                );
                if (!defectTypeResponse.ok) {
                    throw new Error("缺陷类型加载失败");
                }
                state.defectTypes = await defectTypeResponse.json();
                renderDefectTypes();
                await refreshData();
                setStatus("", "");
            } catch (error) {
                setStatus(error.message || "页面加载失败", "error");
            }
        }

        document.getElementById("add-box").addEventListener(
            "click",
            addDraftAnnotation
        );
        document.getElementById("save-annotations").addEventListener(
            "click",
            () => saveAnnotations().catch((error) =>
                setStatus(error.message, "error")
            )
        );
        document.getElementById("review-annotations").addEventListener(
            "click",
            () => reviewAnnotations().catch((error) =>
                setStatus(error.message, "error")
            )
        );

        initialize();
    </script>
</body>
</html>